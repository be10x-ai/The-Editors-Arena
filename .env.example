###############################################################################
# THE EDITOR ARENA — environment configuration
# Copy to `.env` (local) or paste into Vercel → Project → Settings → Env Vars.
###############################################################################

# --- Core -------------------------------------------------------------------
# Public origin of the app. Used in emails, OAuth callbacks and Drive links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (PostgreSQL) --------------------------------------------------
# Pooled connection used by the app at runtime (e.g. Supabase/Neon pgbouncer).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/editor_arena?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. Same value is fine
# for a plain self-hosted Postgres.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/editor_arena?schema=public"

# --- Supabase (database, auth and storage) ---------------------------------
# One project does three jobs: Postgres behind DATABASE_URL above, the accounts
# people sign in with, and the bucket holding profile photos. Project Settings
# -> API. The service-role key bypasses row-level security and can act as any
# user, so keep it server-side only.
#
# There is no AUTH_SECRET here. Auth used to be NextAuth and is now Supabase, so
# that variable and AUTH_TRUST_HOST are gone — delete them from any older .env
# and from the Vercel project; nothing reads them.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Auth runs on Supabase, so the browser needs the anon key. Safe to expose —
# row-level security still applies to it. Settings -> API -> anon/public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Create a PUBLIC bucket named "avatars" in Supabase Storage before using this.

# --- Email (SMTP) -----------------------------------------------------------
# The app sends every message itself over SMTP — registration, the four
# reminders, task-files-released, submission-received, results, judge invites
# and the sign-in fallback code.
#
# Supabase cannot carry these. Its mailer only fills the six Supabase Auth
# templates, and this app authenticates against its own users table. If you have
# also filled in Supabase's Custom SMTP screen, that is a separate sender using
# the same mailbox — not a hop these emails pass through.
#
# Any host with an SMTP mailbox works. Take the four values from that host's
# control panel; the site's own domain is irrelevant, so a *.vercel.app
# deployment sends perfectly well.
#
# The project's sending mailbox is noreply@theeditorsarena.in — use it for both
# SMTP_USER and MAIL_FROM_EMAIL. Contact/support goes to editpod5@houseofedtech.in,
# which is what the site shows and what a human is meant to reply to.
#
# Keep the two separate: the sending domain needs its own SPF/DKIM records, so
# swapping the envelope sender to a domain without them will land mail in spam.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER="noreply@theeditorsarena.in"
SMTP_PASSWORD=""
# Leave empty to infer: true on port 465 (implicit TLS), false on 587 (STARTTLS).
# Getting this wrong on 465 shows up as a connection that hangs, not an error.
SMTP_SECURE=""
# Keep identical to SMTP_USER. Most relays reject — or silently rewrite — a From
# address the authenticated mailbox does not own.
MAIL_FROM_EMAIL="noreply@theeditorsarena.in"
MAIL_FROM_NAME="The Editor's Arena"

# Verify the relay before a real send:  npm run email:test

# --- Cron -------------------------------------------------------------------
# Shared secret for /api/cron/*. Vercel Cron sends it as a Bearer token.
CRON_SECRET="replace-me-with-a-random-string"

# --- Seed data (used only by `npm run db:seed`) ------------------------------
SEED_ADMIN_EMAIL="editpod5@houseofedtech.in"
SEED_ADMIN_PASSWORD="ChangeThisAdmin#2026"
SEED_JUDGE_PASSWORD="ChangeThisJudge#2026"
# Set to "true" to also create 12 demo contestants with submissions + ratings.
SEED_DEMO_DATA="false"

# --- Feature flags ----------------------------------------------------------
# When "true", every outbound email is logged to the console instead of sent.
# Email is all this gates.
#
# Keep it "true" until `npm run email:test` passes, so a half-configured
# deployment cannot mail the entrant list. Keep it "true" locally too whenever
# DATABASE_URL points at the live database — otherwise draining the reminder
# queue from a dev machine sends real email to real contestants.
INTEGRATIONS_DRY_RUN="true"
