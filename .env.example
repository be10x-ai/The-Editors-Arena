###############################################################################
# THE EDITOR ARENA — environment configuration
# Copy to `.env` (local) or paste into Vercel → Project → Settings → Env Vars.
###############################################################################

# --- Core -------------------------------------------------------------------
# Public origin of the app. Used in emails, OAuth callbacks and Drive links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (PostgreSQL) --------------------------------------------------
# Pooled connection used by the app at runtime (e.g. Supabase/Neon pgbouncer).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/editor_arena?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. Same value is fine
# for a plain self-hosted Postgres.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/editor_arena?schema=public"

# --- Auth.js / NextAuth v5 --------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Required on Vercel behind a proxy.
AUTH_TRUST_HOST="true"

# --- Google service account (Drive + Sheets) --------------------------------
# Create a service account in Google Cloud, enable Drive API + Sheets API +
# Gmail API, then download the JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL="editor-arena@your-project.iam.gserviceaccount.com"
# Paste the private key with literal \n escapes, wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# --- Google Drive -----------------------------------------------------------
# Root folder that holds every submission. Share it with the service account
# as Content manager (a Shared Drive is strongly recommended — see DEPLOYMENT).
GOOGLE_DRIVE_SUBMISSIONS_FOLDER_ID=""
# Optional: Shared Drive ID. Leave empty when using a normal My Drive folder.
GOOGLE_DRIVE_ID=""

# --- Google Sheets ----------------------------------------------------------
# Spreadsheet ID from the sheet URL: /spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB="Registrations"

# --- Supabase Storage (contestant profile photos) -------------------------
# Only Storage uses these — the database goes through Prisma and auth is this
# app's own. Project Settings -> API. The service-role key bypasses row-level
# security, so keep it server-side only.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Create a PUBLIC bucket named "avatars" in Supabase Storage before using this.

# --- Email (SMTP) -----------------------------------------------------------
# Any SMTP relay works — Resend, Brevo, Amazon SES, Postmark, Mailgun. These are
# the same credentials Supabase's Custom SMTP screen asks for; Supabase itself
# cannot relay these emails, as its mailer only serves Supabase Auth flows and
# this app authenticates against its own users table.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Leave empty to infer: true on port 465 (implicit TLS), false on 587 (STARTTLS).
SMTP_SECURE=""
# The From address. Must be on a domain the relay is verified to send for.
MAIL_FROM_EMAIL="arena@yourdomain.com"
MAIL_FROM_NAME="The Editor's Arena"

# --- Cron -------------------------------------------------------------------
# Shared secret for /api/cron/*. Vercel Cron sends it as a Bearer token.
CRON_SECRET="replace-me-with-a-random-string"

# --- Seed data (used only by `npm run db:seed`) ------------------------------
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="ChangeThisAdmin#2026"
SEED_JUDGE_PASSWORD="ChangeThisJudge#2026"
# Set to "true" to also create 12 demo contestants with submissions + ratings.
SEED_DEMO_DATA="false"

# --- Feature flags ----------------------------------------------------------
# When "true", integrations log to console instead of calling Google APIs.
# Keep "true" until the service account is wired up, so registration never 500s.
INTEGRATIONS_DRY_RUN="true"
