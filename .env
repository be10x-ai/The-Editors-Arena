###############################################################################
# THE EDITOR ARENA — local environment. Gitignored; never commit this file.
# Vercel needs its own copy: Project → Settings → Environment Variables.
###############################################################################

# --- Core -------------------------------------------------------------------
# Public origin. Every link in every email is built from this, so on Vercel it
# must be the real deployment URL, not localhost.
NEXT_PUBLIC_APP_URL="https://the-editors-arena.vercel.app"

# --- Database (Supabase Postgres, project qiunsdscglxoyymdvwvk, ap-south-1) ---
# Runtime uses the transaction pooler (6543). `pgbouncer=true` stops Prisma
# issuing prepared statements pgbouncer cannot hold across a transaction.
DATABASE_URL="postgresql://postgres.qiunsdscglxoyymdvwvk:7Qmua8EUrVNKsuzb@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# `prisma migrate` needs a session connection, not a transaction pooler (5432).
DIRECT_DATABASE_URL="postgresql://postgres.qiunsdscglxoyymdvwvk:7Qmua8EUrVNKsuzb@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Auth.js / NextAuth v5 --------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="drpOhUfJssTnR+3cIuHmQHCpoRg875C9cOr3XCHb5I8="
# Required on Vercel behind a proxy.
AUTH_TRUST_HOST="true"

# --- Supabase Storage (contestant profile photos) ---------------------------
# Settings → API. The service-role key bypasses row-level security, so it is
# server-only and must never be exposed to the browser. Create a PUBLIC bucket
# named "avatars" first. Left empty, photo upload is simply disabled.
NEXT_PUBLIC_SUPABASE_URL="https://qiunsdscglxoyymdvwvk.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFpdW5zZHNjZ2x4b3l5bWR2d3ZrIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTQ3NTE4MSwiZXhwIjoyMTAxMDUxMTgxfQ.XQ1EXSxUD5kz-0Sy07qWrYunfYvXJaKGafH7bPApfoI"
# Auth runs on Supabase, so the browser needs the anon key. Safe to expose —
# row-level security still applies. Settings -> API -> anon/public.
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFpdW5zZHNjZ2x4b3l5bWR2d3ZrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU0NzUxODEsImV4cCI6MjEwMTA1MTE4MX0.kPK5TMVrP-G17_uSqtDo8PbvIDycg2f61NXira2s4EU"

# --- Outbound mail (SMTP) ---------------------------------------------------
# Mailbox on theeditorsarena.in. Supabase's Custom SMTP screen holds these same
# values, but it is a separate sender for Supabase Auth's own templates — this
# app talks to the relay directly.
#
# SMTP_HOST / SMTP_PORT / SMTP_SECURE below are the Hostinger defaults; confirm
# them against whichever host serves theeditorsarena.in mail.
#
# SMTP_PASSWORD: pending — the mailbox password from the provider's control
# panel (Hostinger: hPanel → Emails → noreply@theeditorsarena.in).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
# Must be true on 465 (implicit TLS). Wrong here means a hang, not an error.
SMTP_SECURE="true"
SMTP_USER="noreply@theeditorsarena.in"
SMTP_PASSWORD=""
# Keep identical to SMTP_USER — relays reject a From they do not own.
MAIL_FROM_EMAIL="noreply@theeditorsarena.in"
MAIL_FROM_NAME="The Editor's Arena"
# Verify before trusting it:  npm run email:test

# --- Cron -------------------------------------------------------------------
# Bearer token for /api/cron/*. Vercel must hold this exact value.
CRON_SECRET="e216725870497228b981413eb1c488be91d061c2689ca69a"

# --- Seed data (used only by `npm run db:seed`) ------------------------------
SEED_ADMIN_EMAIL="info@theeditorsarena.in"
SEED_ADMIN_PASSWORD="ChangeThisAdmin#2026"
SEED_JUDGE_PASSWORD="ChangeThisJudge#2026"
# Set to "true" to also create 12 demo contestants with submissions + ratings.
SEED_DEMO_DATA="false"

# --- Feature flags ----------------------------------------------------------
# "true" logs integrations to console instead of calling them. Back to "true"
# while SMTP_PASSWORD is empty — with no credentials every send would fail at
# the relay, so dry-run keeps that out of the queue. Flip to "false" once
# `npm run email:test` passes on the new mailbox. Drive and Sheets stay off
# regardless while their IDs are empty, so uploads return a clean 503 rather
# than failing mid-request.
INTEGRATIONS_DRY_RUN="true"
